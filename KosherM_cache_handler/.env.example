SERVER_HOST= # Server host
INGEST_SECRET= # Shared secret sent as x-ingest-secret header; must match INGEST_SECRET in the buzzweight (Vercel) env
TRAILER_ID= # Trailer ID
MQTT_TOPIC= # MQTT topic
MQTT_HOST= # MQTT host
MQTT_PORT= # MQTT port
REDIS_HOST= # Redis host
REDIS_PORT= # Redis port
AGGREGATION_INTERVAL= # Aggregation interval in milliseconds (5 minutes at least)
CACHE_EXPIRATION= # Cache expiration in seconds (10 minutes at least)