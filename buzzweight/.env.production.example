# =============================================================================
# BuzzWeight — PRODUCTION environment variables (Vercel)
# =============================================================================
# Copy each of these into your Vercel project:
#   Settings → Environment Variables (scope: Production, and Preview if desired)
# Do NOT commit real values. This file documents names + where to get them.
#
# Vercel note: set the project's Root Directory to "buzzweight" (monorepo).
# =============================================================================

# --- Supabase (managed cloud project) ---------------------------------------
# From Supabase → Project Settings → API.
# The URL + anon key are public (inlined into the client bundle at build time).
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# SECRET — server-side only, bypasses Row Level Security. Never expose to the
# client and never prefix with NEXT_PUBLIC. Used for sensor writes, dashboard
# reads and the admin invite endpoint.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# --- Ingestion (POST /api/data) ---------------------------------------------
# Shared secret sent by the on-site cache-handler as the `x-ingest-secret`
# header. Generate a strong value:  openssl rand -hex 32
# The SAME value must be set in the cache-handler's env on your edge device.
INGEST_SECRET=<generate-with-openssl-rand-hex-32>

# --- Admin invites (POST /api/admin/invite) ---------------------------------
# Optional comma-separated allowlist of emails permitted to invite users.
# Leave empty to allow any authenticated user to invite.
ADMIN_EMAILS=chrisalexiev@icloud.com

# --- Contact form (Resend) --------------------------------------------------
# From resend.com. CONTACT_FROM must be an address on a domain you have
# verified in Resend (onboarding@resend.dev works for testing only).
RESEND_API_KEY=<your-resend-api-key>
CONTACT_TO=chrisalexiev@icloud.com
CONTACT_FROM=BuzzWeight <hello@yourdomain.com>

# =============================================================================
# Reminders (configured in the Supabase dashboard, not here):
#   • Authentication → Email provider: ENABLED (this is the login switch)
#   • Authentication → "Allow new users to sign up": OFF (invite-only)
#   • Authentication → URL Configuration → Site URL: https://your-app.vercel.app
#   • Authentication → Redirect URLs: add https://your-app.vercel.app/auth/callback
#   • Authentication → SMTP: configure custom SMTP so invites/password-resets send
#   • Apply migrations:  supabase link --project-ref <ref> && supabase db push
# =============================================================================
