# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-side only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required on POST /api/data (x-ingest-secret header).
# Must match INGEST_SECRET in the KosherM_cache_handler env.
INGEST_SECRET=

# Optional comma-separated allowlist of emails allowed to call /api/admin/invite.
# If empty, any authenticated user may invite.
ADMIN_EMAILS=

# Contact form (Resend). Get a key at https://resend.com.
RESEND_API_KEY=
# Where contact-form submissions are delivered.
CONTACT_TO=chrisalexiev@icloud.com
# Verified sender. Use onboarding@resend.dev for testing, or your own domain.
CONTACT_FROM=BuzzWeight <onboarding@resend.dev>
